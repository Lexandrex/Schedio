{
  "name": "schedio-drasis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "test": "npm run test:node && npm run test:client",
    "test:node": "npm run test:unit && npm run test:api",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:api": "node --test \"tests/api/*.test.mjs\"",
    "test:client": "npm --prefix client test",
    "test:coverage": "c8 npm run test:node && npm run coverage:backend && npm --prefix client run test:coverage && npm run coverage:frontend",
    "coverage:backend": "c8 report --include=\"*.js\" --reporter=text-summary --check-coverage --lines 75",
    "coverage:frontend": "c8 report --all=false --include=\"client/src/**/*.js\" --reporter=json --reports-dir=coverage/frontend-node --temp-directory=coverage/tmp && node scripts/cobertura-frontend.mjs 25",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "db:migrate": "node scripts/migrate.js",
    "db:verify": "node scripts/verify-migration.js",
    "auth:inspect": "node scripts/inspect-auth-status.js",
    "smtp:inspect": "node scripts/inspect-smtp-config.js",
    "storage:inspect": "node scripts/inspect-storage-config.js",
    "contas:expurgar": "node scripts/expurgar-contas.js",
    "projetos:importar": "node scripts/importar-projetos.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^6.9.5",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0"
  }
}
